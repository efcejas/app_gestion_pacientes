{
  "name": "app_gestion_pacientes",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
  "build": "npm run build-css-prod",
  "heroku-postbuild": "npm run build-css-prod",
    "build-css": "tailwindcss -i ./static/styles/input.css -o ./static/styles/tailwind.css",
    "build-css-watch": "tailwindcss -i ./static/styles/input.css -o ./static/styles/tailwind.css --watch",
    "build-css-prod": "tailwindcss -i ./static/styles/input.css -o ./static/styles/tailwind.css --minify",
    "collectstatic": "python manage.py collectstatic --noinput",
    "build-and-collect": "npm run build-css && npm run collectstatic",
    "dev-windows": "dev.bat",
    "dev": "concurrently \"npm run build-css-watch\" \"python manage.py runserver\" --names \"🎨CSS,🚀DJANGO\" --prefix-colors \"blue,green\""
  },
  "keywords": [],
