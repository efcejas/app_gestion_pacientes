# Ignorar el archivo .env
.env

# Base de datos local (si usas SQLite)
*.sqlite3

# Ignorar todo dentro de migrations excepto los archivos .py
**/migrations/__pycache__/
**/migrations/*.pyc
!*/migrations/*.py

# Archivos de compilación de Python
*.pyc
__pycache__/

# Configuración de IDEs
.vscode/
.idea/

# Archivos de sistema (Mac/Windows)
.DS_Store
Thumbs.db

# Ignorar el entorno virtual
venv_gestion_pacientes/
venv/

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# npm logs
.npm

# CSS compilado (se genera con npm run build-css)
.env
scripts/
# static/styles/tailwind.css

# Opcional: Descomentar si no quieres trackear el CSS compilado
# Deja comentado si quieres incluir el CSS en el repo para deployment